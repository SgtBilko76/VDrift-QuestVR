; VDrift VR controls: the Touch controllers as virtual joystick 0.
; Seeded into /sdcard/VDriftVR/.vdrift/controls.config on first run; the game
; rewrites it when a control is changed in Options -> Controls.
;
;   axis 0  left stick X            axis 1  right trigger
;   axis 4  left trigger            axis 2/3/5  the other stick axes
;   button 0 right grip   1 left grip   2 A   3 Y   4 B   5 X
;   button 6 left stick click   7 right stick click
;   button 8/9/10/11 left stick up/down/left/right   12 left menu button

[control mapping 00]
name = gas
type = joy
joy_index = 0
joy_type = axis
joy_axis = 1
joy_axis_type = positive
deadzone = 0.02
exponent = 1.0
gain = 1.0

[control mapping 01]
name = brake
type = joy
joy_index = 0
joy_type = axis
joy_axis = 4
joy_axis_type = positive
deadzone = 0.02
exponent = 1.0
gain = 1.0

[control mapping 02]
name = steer_left
type = joy
joy_index = 0
joy_type = axis
joy_axis = 0
joy_axis_type = negative
deadzone = 0.0
exponent = 1.0
gain = 1.0

[control mapping 03]
name = steer_right
type = joy
joy_index = 0
joy_type = axis
joy_axis = 0
joy_axis_type = positive
deadzone = 0.0
exponent = 1.0
gain = 1.0

